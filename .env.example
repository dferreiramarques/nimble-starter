# Copy to .env for local development (or set these as Variables on your host). Never commit real values.

# Google sign-in: an OAuth "Web application" client from Google Cloud Console.
# Authorized redirect URI to add:  <your site>/auth/callback   e.g. http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the sign-in cookie. A long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# The public address of this site, e.g. https://app.example.com. Recommended in production
# (otherwise it is detected from the request).
PUBLIC_URL=

# Port (most hosts set this themselves)
PORT=3000

# Prefix for the cookie names and the key derivation: a short id for this product (letters and digits only), e.g. mytool
APP_ID={{APP_ID}}
